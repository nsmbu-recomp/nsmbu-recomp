{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest.schema.json",
  "title": "NSMBU mod manifest",
  "type": "object",
  "unevaluatedProperties": false,
  "required": ["format_version", "id", "name", "version", "game_id", "kind"],
  "properties": {
    "$schema": { "type": "string" },
    "format_version": { "type": "integer", "enum": [1, 2] },
    "id": { "$ref": "#/$defs/modId" },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "version": { "$ref": "#/$defs/semver" },
    "game_id": { "const": "nsmbu-usa" },
    "author": { "type": "string", "maxLength": 256 },
    "description": { "type": "string", "maxLength": 8192 },
    "minimum_manager_version": { "$ref": "#/$defs/semver" },
    "kind": { "enum": ["lua", "cemu", "content"] },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependency" }
    },
    "conflicts": {
      "type": "array",
      "items": { "$ref": "#/$defs/modId" }
    },
    "options": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/option" }
    },
    "content_dir": { "$ref": "#/$defs/relPath" },
    "cemu_dir": {
      "anyOf": [
        { "type": "string", "maxLength": 0 },
        { "$ref": "#/$defs/relPath" }
      ]
    },
    "lua": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api_version"],
      "properties": {
        "api_version": { "const": 1 },
        "entry": { "$ref": "#/$defs/relPath" }
      }
    }
  },
  "allOf": [
    { "$ref": "#/$defs/luaPackage" },
    { "$ref": "#/$defs/cemuPackage" },
    { "$ref": "#/$defs/contentPackage" }
  ],
  "$defs": {
    "modId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9_-][a-z0-9_.-]*$"
    },
    "semver": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "relPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*\\\\)(?!.*:)[A-Za-z0-9_./-]+$"
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/modId" },
        "minimum_version": { "$ref": "#/$defs/semver" }
      }
    },
    "option": {
      "oneOf": [
        { "$ref": "#/$defs/boolOption" },
        { "$ref": "#/$defs/numberOption" },
        { "$ref": "#/$defs/stringOption" },
        { "$ref": "#/$defs/enumOption" },
        { "$ref": "#/$defs/radioOption" }
      ]
    },
    "boolOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type", "default"],
      "properties": {
        "id": { "$ref": "#/$defs/modId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "description": { "type": "string", "maxLength": 8192 },
        "type": { "const": "bool" },
        "default": { "type": "boolean" }
      }
    },
    "numberOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type", "default", "min", "max"],
      "properties": {
        "id": { "$ref": "#/$defs/modId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "description": { "type": "string", "maxLength": 8192 },
        "type": { "const": "number" },
        "default": { "type": "number" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number", "exclusiveMinimum": 0 }
      },
      "description": "default is a number from min through max. The Mods tab moves by step. step defaults to 1 when omitted."
    },
    "stringOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type", "default"],
      "properties": {
        "id": { "$ref": "#/$defs/modId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "description": { "type": "string", "maxLength": 8192 },
        "type": { "const": "string" },
        "default": { "type": "string", "maxLength": 1024 }
      }
    },
    "enumOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type", "default", "choices"],
      "properties": {
        "id": { "$ref": "#/$defs/modId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "description": { "type": "string", "maxLength": 8192 },
        "type": { "const": "enum" },
        "default": { "type": "string", "maxLength": 128 },
        "choices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      },
      "description": "default is one of the choice names."
    },
    "radioOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type", "default", "choices", "labels"],
      "properties": {
        "id": { "$ref": "#/$defs/modId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "description": { "type": "string", "maxLength": 8192 },
        "type": { "const": "radio" },
        "default": { "type": "string", "maxLength": 128 },
        "choices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "labels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      },
      "description": "labels has one label for each choice. The script reads the choice, not the label."
    },
    "luaPackage": {
      "if": {
        "properties": { "kind": { "const": "lua" } },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "format_version": { "enum": [1, 2] }
        },
        "not": {
          "anyOf": [
            { "required": ["abi_version"] },
            { "required": ["binaries"] },
            { "required": ["guest"] },
            { "required": ["cemu_dir"] }
          ]
        },
        "anyOf": [
          { "required": ["content_dir"] },
          {
            "required": ["lua"],
            "properties": {
              "lua": { "required": ["entry"] }
            }
          }
        ]
      }
    },
    "cemuPackage": {
      "if": {
        "properties": { "kind": { "const": "cemu" } },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "format_version": { "const": 1 }
        },
        "required": ["cemu_dir"],
        "not": {
          "anyOf": [
            { "required": ["lua"] },
            { "required": ["content_dir"] }
          ]
        }
      }
    },
    "contentPackage": {
      "if": {
        "properties": { "kind": { "const": "content" } },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "format_version": { "const": 1 },
          "dependencies": { "maxItems": 0 },
          "options": { "maxItems": 0 }
        },
        "required": ["content_dir"],
        "not": {
          "anyOf": [
            { "required": ["lua"] },
            { "required": ["cemu_dir"] }
          ]
        }
      }
    }
  }
}
