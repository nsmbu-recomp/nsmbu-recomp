{
  "$schema": "../../sdk/manifest.schema.json",
  "format_version": 2,
  "id": "example.level-editor",
  "name": "Level editor",
  "version": "0.1.0",
  "game_id": "nsmbu-usa",
  "description": "Spawn selected objects near the player at runtime and clear actors of the chosen profile.",
  "kind": "lua",
  "lua": {
    "api_version": 1,
    "entry": "main.lua"
  },
  "options": [
    {
      "id": "spawn_kind",
      "name": "Spawn object",
      "type": "enum",
      "default": "off",
      "choices": [
        "off",
        "coin",
        "mushroom",
        "fire flower",
        "one-up",
        "goomba",
        "star"
      ]
    },
    {
      "id": "spawn_every",
      "name": "Spawn interval (seconds)",
      "type": "number",
      "default": 2,
      "min": 1,
      "max": 10,
      "step": 1
    },
    {
      "id": "spawn_offset_x",
      "name": "Spawn X offset",
      "type": "number",
      "default": 0,
      "min": -300,
      "max": 300,
      "step": 16
    },
    {
      "id": "spawn_offset_y",
      "name": "Spawn Y offset",
      "type": "number",
      "default": 0,
      "min": -300,
      "max": 300,
      "step": 16
    },
    {
      "id": "clear_kind",
      "name": "Clear actors of the spawn type",
      "type": "bool",
      "default": false
    }
  ]
}
