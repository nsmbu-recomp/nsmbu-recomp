{
  "$schema": "../../sdk/manifest.schema.json",
  "format_version": 2,
  "id": "example.intro-skip",
  "name": "Intro skip",
  "version": "0.1.0",
  "game_id": "nsmbu-usa",
  "description": "Skips the opening and enters course pack 1-1 for the chosen save file. It does not open time attack.",
  "kind": "lua",
  "lua": {
    "api_version": 1,
    "entry": "main.lua"
  },
  "options": [
    {
      "id": "save_file",
      "name": "Save file",
      "type": "radio",
      "default": "1",
      "choices": ["1", "2", "3"],
      "labels": ["1", "2", "3"]
    },
    {
      "id": "course_pack",
      "name": "Course pack",
      "type": "string",
      "default": "1-1"
    }
  ]
}
