// Opening a course, the world map, and the course HUD.

{
  "hooks": [
    { "address": "02994164" }, // Scene::setNextScene: onSceneChange and scene src for mod API transitions
    {
      "address": "029CBBB4",
      "same": true
      // ErrorViewer::show: this port does not draw it, so the call must not pause the game
    },
    {
      "address": "024BD86C",
      "same": true
      // CourseTask::setupCourse: skip while a story load is leaving the live course
    },
    { "address": "0226FBC4" }, // CourseSelectPlayer::create_: seed map pose before path resolve / spawn
    { "address": "0252F900" }, // PlayerCourseHud::drawStockItemList: AreaTask is null while a course change replaces the area
    { "address": "025CF020" } // AreaTask::getCourseOutHudFlag: AreaTask is null during course teardown
  ],
  "sites": [
    { "address": "024B8324" }, // AreaTask::prepareCourseOutEnter: after enter type 3, seed map checkpoint/pose if still missing
    { "address": "0226FD14" }, // CourseSelectPlayer::create_: seed MainGame pose again before the read
    { "address": "0226FECC" }, // CourseSelectPlayer::create_: seed player fields before pack
    { "address": "02270310" }, // CourseSelectPlayer::create_: seed player fields before pack on the later path
    { "address": "022703A4" }, // CourseSelectPlayer::create_: seed player fields before pack on the fallback path
    { "address": "0227CCF4" }, // CourseSelectCamera::applyFocusFromCheckpointSearch: copy the opened course node into the camera pose
    { "address": "0227E2A8" } // CourseSelectCamera::applyFocusFromCourseSearch: same copy on the course search
  ]
}
