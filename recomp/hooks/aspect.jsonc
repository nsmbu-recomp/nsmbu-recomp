    { "address": "02A062EC" }, // sead::PerspectiveProjection::set: same replacement on the per-frame setter
    // nw::lyt pane placement for widescreen edge HUD.
    { "address": "02ABC054" }, // nw::lyt::Pane::CalculateMtx: shift edge anchors once per pane
    { "address": "02ABCAE8" } // nw::lyt::Pane::Draw: report the layout root's target and skip parked HUD
